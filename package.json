{
  "name": "orchest-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w @orchest/backend",
    "dev:frontend": "npm run dev -w @orchest/frontend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  }
}
